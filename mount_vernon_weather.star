            ),
            render.Padding(
                pad = (2, 4, 0, 0),
                child = render.Text(content = content, font = FONT_FORECAST_TEMP, color = BLACK),
            ),
            render.Padding(
                pad = (1, 1, 0, 0),
                child = render.Text(content = content, font = FONT_FORECAST_TEMP, color = BLACK),
            ),
            render.Padding(
                pad = (3, 1, 0, 0),
