                pad = (2, 1, 0, 0),
                child = render.Text(content = content, font = FONT_FORECAST_TEMP, color = FORECAST_OUTLINE),
            ),
            render.Padding(
                pad = (2, 3, 0, 0),
                child = render.Text(content = content, font = FONT_FORECAST_TEMP, color = FORECAST_OUTLINE),
