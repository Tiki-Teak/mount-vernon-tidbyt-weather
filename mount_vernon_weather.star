SCENIC_BACKGROUNDS = {
    "sunny": "",
    "partly_cloudy": "",
    "cloudy": "",
    "rain": "",
    "snow": "",
    "mixed": "",
    "storm": "",
    "fog": "",
    "clear_night": "",
    "cloudy_night": "",
