def round_temp(value):
    return int(float(value) + (0.5 if float(value) >= 0 else -0.5))

def temperature_color(value, units = "Fahrenheit", night = False):
    fahrenheit = float(value)
    if units == "Celsius":
        fahrenheit = fahrenheit * 9.0 / 5.0 + 32.0

    # Two-degree steps make the color feel continuous while keeping every
    # shade bright enough to survive the Tidbyt panel and a blue storm scene.
    colors = [
        "#FFFFFF",
        "#F7FCFF",
        "#EEF9FF",
        "#E5F5FF",
        "#DDF2FF",
        "#D4EEFF",
        "#CBEAFF",
        "#C1E6FF",
        "#B6E1FF",
        "#ABDCFF",
        "#A0D7FF",
        "#A8D8FA",
        "#B7DCF0",
        "#C9E0E2",
        "#DDE4CF",
        "#F1E8B9",
        "#FFE3A0",
        "#FFDA7F",
        "#FFD064",
        "#FFC34D",
        "#FFB33B",
        "#FFA02F",
        "#FF8C2B",
        "#FF792D",
        "#FF6732",
        "#FF5738",
        "#FA4939",
        "#F23D38",
        "#E93234",
        "#DF2830",
        "#D6202B",
        "#CF1926",
        "#C91322",
        "#C20F1F",
        "#BC0B1C",
    ]
    if fahrenheit <= 32:
        return colors[0]
    index = int((fahrenheit - 32) / 2)
    if index >= len(colors):
        index = len(colors) - 1
    return colors[index]

def low_color(night):
    return NIGHT_LOW_BLUE if night else LOW_BLUE

def high_color(night):
    return NIGHT_HIGH_CORAL if night else HIGH_CORAL

def weather_kind(code, is_day = True):
    code = int(code)
    if code == 0:
        return "sunny" if is_day else "moon"
    if code == 1:
        return "mostly_clear" if is_day else "cloudy"
    if code == 2:
        return "partly_cloudy" if is_day else "cloudy"
    if code == 3:
        return "cloudy"
    if code == 45 or code == 48:
        return "foggy"
    if code == 56 or code == 57 or code == 66 or code == 67:
        return "freezing_rain"
    if code == 51 or code == 61 or code == 80:
        return "rain_light"
    if code == 55 or code == 65 or code == 82:
        return "rain_heavy"
    if code == 53 or code == 63 or code == 81:
        return "rainy"
    if code == 71 or code == 77 or code == 85:
        return "snow_light"
    if code == 75 or code == 86:
        return "snow_heavy"
    if code == 73:
        return "snow"
    if code == 96 or code == 99:
        return "storm_severe"
    if code == 95:
        return "storm"
    return "cloudy"

def number_or(value, fallback = 0):
    return fallback if value == None else float(value)

def refined_current_kind(current, air = {}):
    is_day = int(current["is_day"]) == 1
    kind = weather_kind(current["weather_code"], is_day)
    if kind == "partly_cloudy" and number_or(current.get("cloud_cover")) >= 65:
        kind = "mostly_cloudy"
    gust = number_or(current.get("wind_gusts_10m"))
    wind = number_or(current.get("wind_speed_10m"))
    visibility = number_or(current.get("visibility"), 100000)
    aod = number_or(air.get("aerosol_optical_depth"))
    pm25 = number_or(air.get("pm2_5"))
    liquid = number_or(current.get("rain")) + number_or(current.get("showers"))
    snowfall = number_or(current.get("snowfall"))

    if liquid > 0 and snowfall > 0:
        return "wintry_mix"

    # Precipitation and thunder always outrank visibility/wind artwork.
    wet = kind in ["rain_light", "rainy", "rain_heavy", "snow_light", "snow", "snow_heavy", "freezing_rain", "storm", "storm_severe"]
    if not wet:
        if visibility < 1000:
            return "foggy"
        if pm25 >= 35.5 and aod >= 0.35:
            return "smoke"
        if aod >= 0.45:
            return "haze"
        if gust >= 35 or wind >= 28:
            return "wind_high"
        if gust >= 25 or wind >= 20:
            return "windy"
        if gust >= 20 or wind >= 15:
            return "wind_breezy"
    if kind == "snow_heavy" and (gust >= 25 or wind >= 20):
        return "blowing_snow"
    return kind

def forecast_weather_kind(daily, index):
    kind = weather_kind(daily["weather_code"][index])
    rain = number_or(daily.get("rain_sum", [0, 0, 0, 0])[index]) + number_or(daily.get("showers_sum", [0, 0, 0, 0])[index])
    snow = number_or(daily.get("snowfall_sum", [0, 0, 0, 0])[index])
    gust = number_or(daily.get("wind_gusts_10m_max", [0, 0, 0, 0])[index])
    if rain > 0 and snow > 0:
        return "wintry_mix"
    if kind == "snow_heavy" and gust >= 25:
        return "blowing_snow"
    return kind

def current_icon(kind, width = 24, height = 22):
    return render.Image(
        width = width,
        height = height,
        src = base64.decode(CURRENT_ICONS[kind]),
    )

def forecast_icon(kind, width = 11, height = 11):
    if kind == "rainy":
        return render.Image(width = width, height = height, src = FORECAST_RAIN_SHIFTED_SVG)
    source = FORECAST_ICONS[kind]
    return render.Image(
        width = width,
        height = height,
        src = base64.decode(source),
    )

def forecast_scene(kind, width = 21, height = 17):
    # The forecast uses the same illustrated artwork as Current Conditions,
    # scaled to fill its column and held completely still.
    source = FINAL_FORECAST_SCENES[kind] if kind in FINAL_FORECAST_SCENES else (FINAL_SCENES[kind] if kind in FINAL_SCENES else WEATHER_SCENES[kind])
    if kind == "sunny":
        source = FINAL_SUN_FRAMES[0]
    elif kind == "partly_cloudy":
        source = FINAL_PARTLY_FRAMES[0]
    return render.Image(width = width, height = height, src = base64.decode(source))

def weather_scene(kind, scene_frame = 0):
    # Reserve a full 30-pixel black field for the metrics, including the
    # high-temperature degree symbol and its one-pixel outline.
    width = 33
    source = FINAL_SCENES[kind] if kind in FINAL_SCENES else WEATHER_SCENES[kind]
    if kind in FINAL_PRECIP_FRAMES:
        source = FINAL_PRECIP_FRAMES[kind][scene_frame % len(FINAL_PRECIP_FRAMES[kind])]
    elif kind == "sunny":
        source = FINAL_SUN_FRAMES[scene_frame % len(FINAL_SUN_FRAMES)]
    elif kind == "partly_cloudy":
        # Partly cloudy is intentionally completely static.
        source = FINAL_PARTLY_FRAMES[0]
    return render.Image(
        width = width,
        height = 28,
        src = base64.decode(source),
    )

def scenic_background(kind):
    return render.Image(
        width = 64,
        height = 32,
        src = base64.decode(SCENIC_BACKGROUNDS[kind]),
    )

def scenic_kind(code, is_day):
    code = int(code)
    if not is_day:
        if code == 0:
            return "clear_night"
        if code <= 3:
            return "cloudy_night"
    kind = weather_kind(code, is_day)
    if kind == "sunny":
        return "sunny"
    if kind == "partly_cloudy":
        return "partly_cloudy"
    if kind == "rainy":
        return "rain"
    if kind == "sleet_rain":
        return "mixed"
    if kind == "foggy":
        return "fog"
    return kind

def outlined_text(content, font, color, outline, radius):
    children = []
    size = radius * 2 + 1
    for y in range(size):
        for x in range(size):
            # At one pixel, cardinal neighbors form a crisp halo without
            # filling every tiny counter in the 3x5 font. The two-pixel main
            # temperature uses the complete square halo requested.
            use_pixel = radius > 1 or abs(x - radius) + abs(y - radius) == 1
            if (x != radius or y != radius) and use_pixel:
                children.append(render.Padding(
                    pad = (x, y, 0, 0),
                    child = render.Text(content = content, font = font, color = outline),
                ))
    children.append(render.Padding(
        pad = (radius, radius, 0, 0),
        child = render.Text(content = content, font = font, color = color),
    ))
    return render.Stack(children = children)

def complete_outlined_text(content, font, color, outline):
    # All eight neighboring pixels are included so the edge remains continuous
    # around corners, diagonals, and degree symbols on the physical display.
    children = []
    for y in range(3):
        for x in range(3):
            if x != 1 or y != 1:
                children.append(render.Padding(
                    pad = (x, y, 0, 0),
                    child = render.Text(content = content, font = font, color = outline),
                ))
    children.append(render.Padding(
        pad = (1, 1, 0, 0),
        child = render.Text(content = content, font = font, color = color),
    ))
    return render.Stack(children = children)

def double_complete_outlined_text(content, font, color, inner_outline, outer_outline):
    # Build two true morphological layers. First dilate the glyph through the
    # complete 5x5 neighborhood in black; then cover its inner 3x3 dilation in
    # gray; finally draw the colored glyph. Drawing only the outer offset
    # positions left gaps around corners and internal turns on real hardware.
    children = []
    for y in range(5):
        for x in range(5):
            children.append(render.Padding(
                pad = (x, y, 0, 0),
                child = render.Text(content = content, font = font, color = outer_outline),
            ))
    for y in range(3):
        for x in range(3):
            children.append(render.Padding(
                pad = (x + 1, y + 1, 0, 0),
                child = render.Text(content = content, font = font, color = inner_outline),
            ))
    children.append(render.Padding(
        pad = (2, 2, 0, 0),
        child = render.Text(content = content, font = font, color = color),
    ))
    return render.Stack(children = children)

def temperature_text(value, color):
    number = str(round_temp(value))
    degree_x = len(number) * 6 + 2

    # Exact approved compact arrangement from the physical-display reference.
    return render.Stack(children = [
        render.Padding(pad = (0, 2, 0, 0), child = double_complete_outlined_text(number, FONT_TEMP, color, TEMPERATURE_EDGE, BLACK)),
        render.Padding(pad = (degree_x, 2, 0, 0), child = tiny_degree(color)),
    ])

def temperature_slash(color):
    # Three columns only: the smallest clean diagonal the LEDs preserve.
    return render.Stack(children = [
        render.Padding(pad = (2, 0, 0, 0), child = render.Box(width = 1, height = 2, color = color)),
        render.Padding(pad = (1, 2, 0, 0), child = render.Box(width = 1, height = 3, color = color)),
        render.Padding(pad = (0, 5, 0, 0), child = render.Box(width = 1, height = 2, color = color)),
    ])

def wind_color(value, units, night):
    knots = float(value)
    if units == "Miles per hour":
        knots = knots * 0.868976
    if knots >= 15:
        return "#A94A3B" if night else "#D85B3F"
    if knots >= 10:
        return "#9B6A36" if night else "#D18A3A"
    return NIGHT_TEXT if night else OFF_WHITE

